@startuml
title Activity Diagram: Manage Watchlist

|User|
start
:Open watchlist;

|UI|
:Display watchlist;

if (Watchlist empty?) then (yes)
  :Display empty watchlist;
else (no)
  :Display watchlist entries;
endif

|User|
if (Add a stock?) then (yes)
  |UI|
  :Open Add Stock dialog;

  repeat
    |User|
    :Enter ticker symbol;

    |System|
    :Validate ticker;

    |UI|
    if (Ticker valid?) then (yes)
      :Show valid ticker;
    else (no)
      :Display invalid-ticker error;
    endif

    |User|
  repeat while (Ticker invalid and retry?) is (yes)
  -> no;

  if (Ticker valid?) then (yes)
    |System|
    :Save stock to watchlist;

    |UI|
    :Display success message;
    :Update watchlist;
  else (no)
    |User|
    :Cancel adding stock;
  endif

else (no)
  if (Remove a stock?) then (yes)
    :Select Remove;

    |UI|
    :Show Yes/No confirmation;

    |User|
    if (Confirm removal?) then (yes)
      |System|
      :Remove stock from watchlist;

      |UI|
      :Update watchlist;
    else (no)
      |UI|
      :Keep stock in watchlist;
    endif
  else (no)
    :Finish viewing watchlist;
  endif
endif

|User|
stop
@enduml
